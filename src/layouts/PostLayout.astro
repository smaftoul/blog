---
import Base from "./Base.astro";
import config from "../config";

export interface Props {
  title: string;
  description: string;
  pubDatetime: Date;
  modDatetime?: Date;
  tags?: string[];
  author?: string;
  canonicalURL?: string;
}

const {
  title,
  description,
  pubDatetime,
  modDatetime,
  tags = [],
  author,
  canonicalURL = new URL(Astro.url.pathname, config.url).href,
} = Astro.props;

const displayAuthor = author ?? config.author;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url: canonicalURL,
  mainEntityOfPage: canonicalURL,
  keywords: tags.join(", ") || undefined,
  datePublished: pubDatetime.toISOString(),
  dateModified: (modDatetime ?? pubDatetime).toISOString(),
  author: { "@type": "Person", name: displayAuthor, url: config.url },
};

function formatDate(d: Date): string {
  return d.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Base title={title} description={description} ogType="article" canonicalURL={canonicalURL}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <article class="brume-post">
    <header class="brume-post-header">
      <!-- Breadcrumb -->
      <nav class="brume-breadcrumb" aria-label="Breadcrumb">
        <a href="/blog">blog</a>
        <span aria-hidden="true"> / </span>
        <span>{title}</span>
      </nav>

      <h1 class="brume-post-title">{title}</h1>
      <p class="brume-post-description">{description}</p>

      <div class="brume-post-meta">
        <time datetime={pubDatetime.toISOString()}>
          {formatDate(pubDatetime)}
        </time>
        {modDatetime && (
          <span class="brume-post-updated">
            &nbsp;· updated <time datetime={modDatetime.toISOString()}>{formatDate(modDatetime)}</time>
          </span>
        )}
        <span>&nbsp;· {displayAuthor}</span>
      </div>

      {tags.length > 0 && (
        <ul class="brume-post-tags" aria-label="Tags">
          {tags.map((tag) => (
            <li>
              <a href={`/blog/tags/${tag}`} class="brume-tag">{tag}</a>
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="brume-post-body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .brume-post {
    max-width: 48rem;
  }

  .brume-breadcrumb {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .brume-breadcrumb a { color: var(--text-muted); }
  .brume-breadcrumb a:hover { color: var(--accent); }

  .brume-post-title {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .brume-post-description {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .brume-post-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .brume-post-updated { opacity: 0.75; }

  .brume-post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin-bottom: 2rem;
  }

  .brume-tag {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text-muted);
    transition: border-color 0.15s, color 0.15s;
  }
  .brume-tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ─── Post body prose ─── */
  .brume-post-body {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
    color: var(--text);
    line-height: 1.75;
  }

  .brume-post-body :global(h2),
  .brume-post-body :global(h3),
  .brume-post-body :global(h4) {
    font-family: var(--font-mono);
    color: var(--text);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .brume-post-body :global(h2) { font-size: 1.4rem; }
  .brume-post-body :global(h3) { font-size: 1.15rem; }

  .brume-post-body :global(p) { margin-bottom: 1rem; }

  .brume-post-body :global(a) { color: var(--link); }
  .brume-post-body :global(a:hover) { color: var(--link-hover); }

  .brume-post-body :global(ul),
  .brume-post-body :global(ol) {
    margin: 0 0 1rem 1.5rem;
  }
  .brume-post-body :global(li) { margin-bottom: 0.25rem; }

  .brume-post-body :global(blockquote) {
    border-left: 3px solid var(--accent);
    margin: 1rem 0;
    padding: 0.5rem 1rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .brume-post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.1em 0.3em;
    color: var(--accent);
  }

  .brume-post-body :global(pre) {
    background: var(--bg-surface) !important;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1.25rem 0;
  }
  .brume-post-body :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.875rem;
    color: var(--text);
  }

  .brume-post-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .brume-post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 0.9rem;
  }
  .brume-post-body :global(th),
  .brume-post-body :global(td) {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .brume-post-body :global(th) {
    background: var(--bg-surface);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
