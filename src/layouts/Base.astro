---
import config from "../config";

export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description = config.description,
  canonicalURL = new URL(Astro.url.pathname, config.url).href,
  ogType = "website",
} = Astro.props;

const pageTitle = title ? `${title} — ${config.title}` : config.title;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={config.title} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Theme: apply saved preference before paint to avoid flash -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const isDark = saved ? saved === "dark" : prefersDark;
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>

    <!-- Extra per-page head content (JSON-LD, alternate links, etc.) -->
    <slot name="head" />
  </head>

  <body class="brume-body">
    <!-- Hidden h-card for IndieWeb identity -->
    <div class="h-card" style="display:none">
      <a class="u-url p-name" href={config.url}>{config.author}</a>
    </div>

    <header class="brume-header">
      <div class="brume-header-inner">
        <a href="/" class="brume-logo" aria-label="Home">
          <span class="brume-logo-bracket">[</span>{config.title}<span class="brume-logo-bracket">]</span>
        </a>

        <nav aria-label="Main navigation">
          <ul class="brume-nav">
            {config.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={["brume-nav-link", { active: currentPath.startsWith(item.href) }]}
                  aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <button id="theme-toggle" class="brume-theme-toggle" aria-label="Toggle dark/light mode" title="Toggle theme">
          <span class="theme-icon-dark">◐</span>
          <span class="theme-icon-light">◑</span>
        </button>
      </div>
    </header>

    <main class="brume-main">
      <slot />
    </main>

    <footer class="brume-footer">
      <div class="brume-footer-inner">
        <span class="brume-footer-copy">
          &copy; {new Date().getFullYear()} {config.author}
        </span>
        <ul class="brume-footer-socials">
          {config.socials.map((s) => (
            <li>
              <a href={s.url} rel="me noopener noreferrer" target="_blank" aria-label={s.label}>
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </footer>

    <!-- Theme toggle script -->
    <script>
      const btn = document.getElementById("theme-toggle");
      btn?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
    </script>
  </body>
</html>

<style>
  /* ─── CSS custom properties: all palette values in one place ─── */
  :root {
    /* dark mode (default) */
    --bg:           #0d0f14;
    --bg-surface:   #141720;
    --bg-surface2:  #1a1f2e;
    --text:         #c9d1d9;
    --text-muted:   #6e7681;
    --accent:       #00e5ff;   /* terminal cyan */
    --accent-alt:   #39ff14;   /* neon green */
    --border:       #21262d;
    --border-hover: #00e5ff66;
    --link:         #00e5ff;
    --link-hover:   #39ff14;

    /* monospace font stack */
    --font-mono: "JetBrains Mono", "Fira Code", ui-monospace, monospace;
    --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  }

  /* light mode overrides — same terminal feel, fog palette */
  html:not(.dark) {
    --bg:           #f0f2f5;
    --bg-surface:   #e4e8ed;
    --bg-surface2:  #d8dde5;
    --text:         #1c2128;
    --text-muted:   #57606a;
    --accent:       #0969da;   /* GitHub blue — readable on light */
    --accent-alt:   #1a7f37;   /* muted green */
    --border:       #d0d7de;
    --border-hover: #0969da66;
    --link:         #0969da;
    --link-hover:   #1a7f37;
  }

  /* ─── Base ─── */
  *,
  *::before,
  *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    background-color: var(--bg);
    color: var(--text);
    transition: background-color 0.2s ease, color 0.2s ease;
    scroll-behavior: smooth;
  }

  /* subtle scanline texture in dark mode only */
  html.dark body::before {
    content: "";
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 229, 255, 0.015) 2px,
      rgba(0, 229, 255, 0.015) 4px
    );
    pointer-events: none;
    z-index: 0;
  }

  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  a {
    color: var(--link);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  a:hover { color: var(--link-hover); }

  /* ─── Header ─── */
  .brume-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(8px);
  }

  .brume-header-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .brume-logo {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    flex-shrink: 0;
    letter-spacing: -0.02em;
  }
  .brume-logo:hover { color: var(--accent); }
  .brume-logo-bracket { color: var(--accent); opacity: 0.7; }

  .brume-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    flex: 1;
  }

  .brume-nav-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
    padding: 0.15rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .brume-nav-link:hover,
  .brume-nav-link.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .brume-theme-toggle {
    background: none;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1rem;
    padding: 0.25rem 0.5rem;
    flex-shrink: 0;
    transition: border-color 0.15s, color 0.15s;
  }
  .brume-theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* show correct icon per theme */
  html.dark  .theme-icon-light { display: none; }
  html:not(.dark) .theme-icon-dark  { display: none; }

  /* ─── Main ─── */
  .brume-main {
    flex: 1;
    max-width: 64rem;
    width: 100%;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    position: relative;
    z-index: 1;
  }

  /* ─── Footer ─── */
  .brume-footer {
    border-top: 1px solid var(--border);
    background-color: var(--bg);
    position: relative;
    z-index: 1;
  }

  .brume-footer-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .brume-footer-copy {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .brume-footer-socials {
    display: flex;
    gap: 1rem;
    list-style: none;
  }
  .brume-footer-socials a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .brume-footer-socials a:hover { color: var(--accent); }

  /* ─── Responsive ─── */
  @media (max-width: 640px) {
    .brume-header-inner { flex-wrap: wrap; padding: 0.5rem 1rem; }
    .brume-nav { gap: 0.25rem 0.75rem; }
    .brume-main { padding: 1.5rem 1rem; }
    .brume-footer-inner { padding: 1rem; }
  }
</style>
