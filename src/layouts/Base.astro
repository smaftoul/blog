---
import config from "../config";
import "../styles/base.css";
import PageHead from "../components/layout/PageHead.astro";
import HiddenIdentity from "../components/layout/HiddenIdentity.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SearchModal from "../components/layout/SearchModal.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";

export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description = config.description,
  canonicalURL = new URL(Astro.url.pathname, config.url).href,
  ogType = "website",
} = Astro.props;

const pageTitle = title ? `${title} — ${config.title}` : config.title;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <PageHead
      title={pageTitle}
      description={description}
      canonicalURL={canonicalURL}
      ogType={ogType}
    >
      <Fragment slot="head">
        <slot name="head" />
      </Fragment>
    </PageHead>
  </head>

  <body class="brume-body">
    <HiddenIdentity />
    <SiteHeader currentPath={currentPath} />
    <SearchModal />

    <main class="brume-main">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
