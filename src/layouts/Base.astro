---
import config from "../config";
import { ClientRouter } from "astro:transitions";

export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description = config.description,
  canonicalURL = new URL(Astro.url.pathname, config.url).href,
  ogType = "website",
} = Astro.props;

const pageTitle = title ? `${title} — ${config.title}` : config.title;
const currentPath = Astro.url.pathname;
const navEmojis: Record<string, string> = {
  blog: "✍️",
  about: "👤",
  now: "⏱️",
  uses: "🧰",
  projects: "🛠️",
  contributions: "🌍",
  links: "🔗",
  inaturalist: "🦉",
  contact: "✉️",
};

const socialEmojis: Record<string, string> = {
  github: "🐙",
  mastodon: "🐘",
  linkedin: "💼",
  spotify: "🎵",
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={config.title} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- IndieWeb: rel=me identity verification -->
    <link rel="me" href="https://github.com/smaftoul" />
    <link rel="me" href="https://hachyderm.io/@smaftoul" />
    <link rel="me" href="https://piaille.fr/@smaftoul" />

    <!-- IndieWeb: webmention + pingback endpoints -->
    <link rel="webmention" href="https://webmention.io/maftoul.eu.org/webmention" />
    <link rel="pingback" href="https://webmention.io/maftoul.eu.org/xmlrpc" />

    <!-- Theme: apply saved preference before paint to avoid flash -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const isDark = saved ? saved === "dark" : prefersDark;
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>

    <!-- GoatCounter analytics — only loaded when feature flag is enabled -->
    {config.features.goatCounter && (
      <script
        is:inline
        data-goatcounter="https://maftoul.goatcounter.com/count"
        async
        src="//gc.zgo.at/count.js"
      ></script>
    )}

    <!-- Mermaid: lazy-load from CDN only on pages that have diagrams -->
    <script>
      async function renderMermaid() {
        const els = Array.from(
          document.querySelectorAll<HTMLElement>("pre.mermaid:not([data-processed])")
        );
        if (!els.length) return;
        const { default: mermaid } = await import(
          // @ts-expect-error — mermaid has no bundled type declarations for CDN import
          "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs"
        );
        const dark = document.documentElement.classList.contains("dark");
        mermaid.initialize({ startOnLoad: false, theme: dark ? "dark" : "default" });
        await mermaid.run({ nodes: els });
      }
      // For View Transitions navigations (subsequent page loads)
      document.addEventListener("astro:page-load", renderMermaid);

      // For initial page load: astro:page-load may have already fired by the time
      // this module script runs (scripts are deferred). Use readyState as the guard.
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", renderMermaid);
      } else {
        renderMermaid();
      }
    </script>

    <!-- Extra per-page head content (JSON-LD, alternate links, etc.) -->
    <slot name="head" />
    <ClientRouter />
  </head>

  <body class="brume-body">
    <!-- Hidden h-card for IndieWeb identity -->
    <div class="h-card" style="display:none">
      <a class="u-url p-name" href={config.url}>{config.author}</a>
    </div>

    <header class="brume-header" data-pagefind-ignore>
      <div class="brume-header-inner">
        <a href="/" class="brume-logo" aria-label="Home">
          <span class="brume-logo-mark" aria-hidden="true">🌫️</span>
          <span class="brume-logo-bracket">[</span>{config.title}<span class="brume-logo-bracket">]</span>
        </a>

        <nav aria-label="Main navigation">
          <ul class="brume-nav">
            {config.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={["brume-nav-link", { active: currentPath.startsWith(item.href) }]}
                  aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
                >
                  <span class="brume-nav-emoji" aria-hidden="true">{navEmojis[item.label] ?? "•"}</span>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <button id="theme-toggle" class="brume-theme-toggle" aria-label="Toggle dark/light mode" title="Toggle theme">
          <span class="theme-icon-dark">◐</span>
          <span class="theme-icon-light">◑</span>
        </button>

        <button id="search-toggle" class="brume-search-btn" aria-label="Search" title="Search (/)">
          🔍
        </button>
      </div>
    </header>

    <!-- Search modal — powered by Pagefind -->
    <div id="search-modal" class="brume-search-modal" role="dialog" aria-modal="true" aria-label="Search" hidden>
      <div class="brume-search-backdrop"></div>
      <div class="brume-search-box">
        <div class="brume-search-input-row">
          <span class="brume-search-slash">🔎</span>
          <input
            id="search-input"
            type="search"
            class="brume-search-input"
            placeholder="search posts, pages…"
            autocomplete="off"
            spellcheck="false"
          />
          <button id="search-close" class="brume-search-close" aria-label="Close search">esc</button>
        </div>
        <div id="search-results" class="brume-search-results"></div>
      </div>
    </div>

    <main class="brume-main" data-pagefind-body>
      <slot />
    </main>

    <footer class="brume-footer" data-pagefind-ignore>
      <div class="brume-footer-inner">
        <span class="brume-footer-copy">
          &copy; {new Date().getFullYear()} {config.author}
        </span>
        <ul class="brume-footer-socials">
          {config.socials.map((s) => (
            <li>
              <a href={s.url} rel="me noopener noreferrer" target="_blank" aria-label={s.label}>
                <span class="brume-social-emoji" aria-hidden="true">{socialEmojis[s.icon] ?? "•"}</span>
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </footer>

    <!-- Theme toggle script -->
    <script is:inline>
      if (!window.__brumeThemeToggleBound) {
        window.__brumeThemeToggleBound = true;
        document.addEventListener("click", function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;
          var btn = target.closest("#theme-toggle");
          if (!btn) return;
          var isDark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("theme", isDark ? "dark" : "light");
        });
      }
    </script>

    <!-- Pagefind search modal script — is:inline so Vite never tries to resolve /pagefind/pagefind.js -->
    <script is:inline>
      // Pagefind only exists after a production build. In dev the catch returns null
      // and the search box shows a helpful message instead of crashing.
      var _pf = null;
      var _searchDebounceTimer;

      async function loadPagefind() {
        if (_pf) return _pf;
        try {
          _pf = await import("/pagefind/pagefind.js");
          await _pf.init();
        } catch {
          _pf = null;
        }
        return _pf;
      }

      function getSearchEls() {
        var modal = document.getElementById("search-modal");
        if (!modal) return null;
        return {
          modal: modal,
          input: document.getElementById("search-input"),
          results: document.getElementById("search-results"),
        };
      }

      function closeSearch() {
        var els = getSearchEls();
        if (!els || !els.input || !els.results) return;
        els.modal.hidden = true;
        els.input.value = "";
        els.results.innerHTML = "";
      }

      function openSearch() {
        var els = getSearchEls();
        if (!els || !els.input) return;
        els.modal.hidden = false;
        els.input.focus();
        loadPagefind();
      }

      async function runSearch(query) {
        var els = getSearchEls();
        if (!els || !els.results) return;
        els.results.innerHTML = "";
        if (!query) return;

        var pf = await loadPagefind();
        if (!pf) {
          els.results.innerHTML = '<p class="brume-search-msg">Search not available in dev mode — run <code>bun run build</code> first.</p>';
          return;
        }

        var search = await pf.search(query);
        if (search.results.length === 0) {
          els.results.innerHTML = '<p class="brume-search-msg">No results.</p>';
          return;
        }

        var items = await Promise.all(search.results.slice(0, 8).map(function(r) { return r.data(); }));
        els.results.innerHTML = items.map(function(item) {
          return '<a href="' + item.url + '" class="brume-search-result">'
          + '<span class="brume-search-result-title">' + (item.meta && item.meta.title ? item.meta.title : item.url) + '</span>'
          + '<span class="brume-search-result-excerpt">' + (item.excerpt || "") + '</span>'
          + '</a>';
        }).join("");
      }

      if (!window.__brumeSearchBound) {
        window.__brumeSearchBound = true;

        document.addEventListener("click", function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;

          if (target.closest("#search-toggle")) {
          openSearch();
          return;
          }
          if (target.closest("#search-close") || target.classList.contains("brume-search-backdrop")) {
          closeSearch();
          }
        });

        document.addEventListener("keydown", function(e) {
          var target = e.target;
          var targetTag = target && target.tagName ? target.tagName : "";
          if (e.key === "/" && targetTag !== "INPUT" && targetTag !== "TEXTAREA") {
          e.preventDefault();
          openSearch();
          }
          if (e.key === "Escape") {
          var els = getSearchEls();
          if (els && !els.modal.hidden) closeSearch();
          }
        });

        document.addEventListener("input", function (event) {
          var target = event.target;
          if (!(target instanceof HTMLInputElement) || target.id !== "search-input") return;
          clearTimeout(_searchDebounceTimer);
          _searchDebounceTimer = setTimeout(function() {
          runSearch(target.value.trim());
          }, 150);
        });

        document.addEventListener("click", function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;
          if (target.closest(".brume-search-result")) {
          // Close before client-side navigation replaces the DOM.
          closeSearch();
          }
        });
      }
    </script>
  </body>
</html>

<style>
  /* ─── CSS custom properties: all palette values in one place ─── */
  :root {
    /* dark mode (default) */
    --bg:           #0d0f14;
    --bg-surface:   #141720;
    --bg-surface2:  #1a1f2e;
    --text:         #c9d1d9;
    --text-muted:   #6e7681;
    --accent:       #00e5ff;   /* terminal cyan */
    --accent-alt:   #39ff14;   /* neon green */
    --border:       #21262d;
    --border-hover: #00e5ff66;
    --link:         #00e5ff;
    --link-hover:   #39ff14;

    /* monospace font stack */
    --font-mono: "JetBrains Mono", "Fira Code", ui-monospace, monospace;
    --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  }

  /* light mode overrides — same terminal feel, fog palette */
  html:not(.dark) {
    --bg:           #f0f2f5;
    --bg-surface:   #e4e8ed;
    --bg-surface2:  #d8dde5;
    --text:         #1c2128;
    --text-muted:   #57606a;
    --accent:       #0969da;   /* GitHub blue — readable on light */
    --accent-alt:   #1a7f37;   /* muted green */
    --border:       #d0d7de;
    --border-hover: #0969da66;
    --link:         #0969da;
    --link-hover:   #1a7f37;
  }

  /* ─── Base ─── */
  *,
  *::before,
  *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    background-color: var(--bg);
    color: var(--text);
    transition: background-color 0.2s ease, color 0.2s ease;
    scroll-behavior: smooth;
  }

  /* subtle scanline texture in dark mode only */
  html.dark body::before {
    content: "";
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 229, 255, 0.015) 2px,
      rgba(0, 229, 255, 0.015) 4px
    );
    pointer-events: none;
    z-index: 0;
  }

  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  a {
    color: var(--link);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  a:hover { color: var(--link-hover); }

  /* ─── Header ─── */
  .brume-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(8px);
  }

  .brume-header-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .brume-logo {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    flex-shrink: 0;
    letter-spacing: -0.02em;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .brume-logo:hover { color: var(--accent); }
  .brume-logo-mark { font-size: 0.95rem; }
  .brume-logo-bracket { color: var(--accent); opacity: 0.7; }

  .brume-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    flex: 1;
  }

  .brume-nav-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
    padding: 0.15rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .brume-nav-emoji { font-size: 0.7rem; opacity: 0.75; }
  .brume-nav-link:hover,
  .brume-nav-link.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .brume-theme-toggle {
    background: none;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1rem;
    padding: 0.25rem 0.5rem;
    flex-shrink: 0;
    transition: border-color 0.15s, color 0.15s;
  }
  .brume-theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* show correct icon per theme */
  html.dark  .theme-icon-light { display: none; }
  html:not(.dark) .theme-icon-dark  { display: none; }

  /* ─── Search button ─── */
  .brume-search-btn {
    background: none;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-muted);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    flex-shrink: 0;
    transition: border-color 0.15s, color 0.15s;
  }
  .brume-search-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ─── Search modal ─── */
  .brume-search-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 8vh;
  }
  .brume-search-modal[hidden] { display: none; }

  .brume-search-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px);
  }

  .brume-search-box {
    position: relative;
    z-index: 1;
    width: min(600px, 92vw);
    background: var(--bg-surface);
    border: 1px solid var(--accent);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 0 40px rgba(0, 229, 255, 0.12);
  }

  .brume-search-input-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .brume-search-slash {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--accent);
    opacity: 0.7;
    flex-shrink: 0;
  }

  .brume-search-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--text);
    caret-color: var(--accent);
  }
  .brume-search-input::placeholder { color: var(--text-muted); }

  .brume-search-close {
    background: none;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text-muted);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.1rem 0.35rem;
    flex-shrink: 0;
    transition: border-color 0.15s, color 0.15s;
  }
  .brume-search-close:hover { border-color: var(--accent); color: var(--accent); }

  .brume-search-results {
    max-height: 60vh;
    overflow-y: auto;
    padding: 0.5rem 0;
  }

  .brume-search-result {
    display: block;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    transition: background 0.1s;
  }
  .brume-search-result:hover { background: var(--bg-surface2); }
  .brume-search-result:last-child { border-bottom: none; }

  .brume-search-result-title {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.25rem;
  }
  .brume-search-result:hover .brume-search-result-title { color: var(--accent); }

  .brume-search-result-excerpt {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
  /* Pagefind highlights the matching term */
  .brume-search-result-excerpt :global(mark) {
    background: none;
    color: var(--accent);
    font-weight: 600;
  }

  .brume-search-msg {
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .brume-search-msg code {
    color: var(--accent);
    background: var(--bg-surface2);
    padding: 0.1em 0.3em;
    border-radius: 3px;
  }

  /* ─── Main ─── */
  .brume-main {
    flex: 1;
    max-width: 64rem;
    width: 100%;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    position: relative;
    z-index: 1;
    view-transition-name: brume-main;
  }

  /* ─── Footer ─── */
  .brume-footer {
    border-top: 1px solid var(--border);
    background-color: var(--bg);
    position: relative;
    z-index: 1;
  }

  .brume-footer-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .brume-footer-copy {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .brume-footer-socials {
    display: flex;
    gap: 1rem;
    list-style: none;
  }
  .brume-footer-socials a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .brume-social-emoji { font-size: 0.72rem; opacity: 0.8; }
  .brume-footer-socials a:hover { color: var(--accent); }

  @keyframes brume-fade-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes brume-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes brume-slide-out {
    from { opacity: 1; transform: translateY(0); filter: blur(0); }
    to { opacity: 0; transform: translateY(-8px); filter: blur(1px); }
  }

  @keyframes brume-slide-in {
    from { opacity: 0; transform: translateY(8px); filter: blur(1px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  :global(::view-transition-old(root)) {
    animation: brume-fade-out 120ms ease-out both;
  }

  :global(::view-transition-new(root)) {
    animation: brume-fade-in 160ms ease-out both;
  }

  :global(::view-transition-old(brume-main)) {
    animation: brume-slide-out 180ms ease-in both;
  }

  :global(::view-transition-new(brume-main)) {
    animation: brume-slide-in 220ms ease-out both;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(::view-transition-old(root)),
    :global(::view-transition-new(root)) {
      animation: none;
    }
  }

  /* ─── Responsive ─── */
  @media (max-width: 640px) {
    .brume-header-inner { flex-wrap: wrap; padding: 0.5rem 1rem; }
    .brume-nav { gap: 0.25rem 0.75rem; }
    .brume-main { padding: 1.5rem 1rem; }
    .brume-footer-inner { padding: 1rem; }
  }
</style>
