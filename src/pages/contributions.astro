---
import { getCollection, render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";

// Load contributions markdown content
const contribPages = await getCollection("pages");
const contribPage = contribPages.find((p) => p.id === "contributions");
const { Content } = contribPage ? await render(contribPage) : { Content: null };
---

<PageLayout
  title={contribPage?.data.title || "Contributions"}
  description={contribPage?.data.description || "Public open-source contributions"}
>
  {Content && (
    <p class="contrib-intro">
      <Content />
    </p>
  )}

  <!-- ── Note ───────────────────────────────────────────────── -->
  <p class="contrib-note">
    <span class="contrib-comment">#</span>
    Most professional work lives in private repositories at past and current employers.
    The commits listed here are from public repositories only.
  </p>
</PageLayout>

<style>
  .contrib-intro {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 42rem;
  }

  .contrib-section { margin-bottom: 2.5rem; }

  .contrib-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 1rem;
  }

  /* ── Cards ── */
  .contrib-card {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .contrib-card:first-child { border-top: 1px solid var(--border); }

  .contrib-card--top {
    border-left: 2px solid var(--accent);
    padding-left: 0.9rem;
  }

  /* ── Header row ── */
  .contrib-card-header {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .contrib-repo {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
  }
  .contrib-repo:hover { color: var(--accent); }

  .contrib-stars {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .contrib-year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-left: auto;
  }

  /* ── Badges ── */
  .contrib-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    border: 1px solid;
    letter-spacing: 0.03em;
  }
  .contrib-badge--feature  { color: var(--accent);      border-color: var(--accent);      }
  .contrib-badge--fix      { color: #f59e0b;             border-color: #f59e0b;             }
  .contrib-badge--chore    { color: var(--text-muted);   border-color: var(--border);       }
  .contrib-badge--docs     { color: #a78bfa;             border-color: #a78bfa;             }
  .contrib-badge--community{ color: var(--accent-alt);   border-color: var(--accent-alt);   }
  .contrib-badge--project  { color: var(--accent);       border-color: var(--accent);       }
  /* PR vs commit source indicators — subtle, filled background */
  .contrib-badge--pr     { color: var(--bg); background: #7c3aed; border-color: #7c3aed;  }
  .contrib-badge--commit { color: var(--bg); background: var(--text-muted); border-color: var(--text-muted); opacity: 0.7; }

  /* ── Commit message ── */
  .contrib-message {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
    font-style: italic;
  }

  /* ── Description ── */
  .contrib-desc {
    font-size: 0.88rem;
    color: var(--text);
    line-height: 1.65;
    max-width: 44rem;
    margin-bottom: 0.4rem;
  }
  .contrib-desc code {
    font-family: var(--font-mono);
    font-size: 0.82em;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.1em 0.3em;
    color: var(--accent);
  }

  /* ── Meta row ── */
  .contrib-meta {
    display: flex;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }
  .contrib-diff { opacity: 0.7; }

  /* ── Aside text (lighter, for tangential notes) ── */
  .contrib-aside {
    color: var(--text-muted) !important;
    font-size: 0.82rem !important;
    font-style: italic;
    opacity: 0.8;
  }

  /* ── Footer note ── */
  .contrib-note {
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    opacity: 0.65;
  }
  .contrib-comment {
    color: var(--accent);
    margin-right: 0.4rem;
    opacity: 0.6;
  }
</style>
