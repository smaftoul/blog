---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Page not found" description="This page does not exist.">
  <div class="brume-404">
    <div class="brume-404-screen">
      <p class="brume-404-prompt"><span class="brume-cursor">▋</span> <span class="brume-404-cmd">cd /this/page</span></p>
      <p class="brume-404-err">bash: cd: /this/page: No such file or directory</p>
      <p class="brume-404-prompt"><span class="brume-cursor">▋</span> <span class="brume-404-code">404</span></p>
    </div>
    <p class="brume-404-msg">This page doesn't exist.</p>
    <nav class="brume-404-nav">
      <a href="/">← home</a>
      <a href="/blog">blog</a>
      <a href="/about">about</a>
    </nav>
  </div>
</Base>

<style>
  .brume-404 {
    max-width: 36rem;
    padding-top: 2rem;
  }

  .brume-404-screen {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.8;
    position: relative;
  }

  /* Fake traffic-light dots */
  .brume-404-screen::before {
    content: "● ● ●";
    position: absolute;
    top: 0.6rem;
    left: 1rem;
    font-size: 0.5rem;
    letter-spacing: 0.4rem;
    color: var(--text-muted);
    opacity: 0.5;
  }

  .brume-404-prompt { color: var(--text-muted); margin-top: 0.25rem; }
  .brume-404-cmd    { color: var(--text); }
  .brume-404-err    { color: #ff5f56; margin-left: 0; font-size: 0.82rem; }

  .brume-404-code {
    font-size: 3rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }

  .brume-cursor {
    color: var(--accent);
    animation: blink 1.2s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  .brume-404-msg {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .brume-404-nav {
    display: flex;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .brume-404-nav a { color: var(--text-muted); }
  .brume-404-nav a:hover { color: var(--accent); }
</style>
